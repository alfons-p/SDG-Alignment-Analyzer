# SDG Alignment Analyzer Configuration

# Model Settings
DEFAULT_EMBEDDING_MODEL=all-mpnet-base-v2
FALLBACK_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Model selection notes:
# - all-mpnet-base-v2: Higher quality, better semantic understanding (RECOMMENDED)
# - all-MiniLM-L6-v2: Faster, smaller, good for prototyping

# Similarity Thresholds
SIMILARITY_THRESHOLD=0.3
HIGH_ALIGNMENT_THRESHOLD=0.5
MIN_ACTIVITY_LENGTH=20

# Paths
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_RESULTS_PATH=data/results
CACHE_DIR=.cache

# Processing
BATCH_SIZE=32
MAX_WORKERS=4

# Optional: OpenAI API (for comparison/upgrade path)
# OPENAI_API_KEY=your_api_key_here
# USE_OPENAI=false

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/sdg_analyzer.log
